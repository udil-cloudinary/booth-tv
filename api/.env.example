# Copy to .env (never commit .env). This is the ONLY place the Cloudinary API secret lives.

# The booth cloud's Admin API credentials (Search API + rendition warm-up).
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<booth_cloud>

# Optional read token. If set, the TV must send "Authorization: Bearer <token>" (VITE_API_TOKEN in app/.env).
# Recommended when the API is on a public URL: the response includes visitors' email addresses.
TV_READ_TOKEN=

# Access-Control-Allow-Origin for the TV page. "*" is fine with a read token; else set the TV's origin.
CORS_ORIGIN=*

# Local Node adapter only.
PORT=8787
# MOCK=1 is the same as --mock. MOCK_RUSH=10 adds 10 mock visitors about 20 s after start.
MOCK=
MOCK_RUSH=
