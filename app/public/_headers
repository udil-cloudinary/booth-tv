# Cloudflare static assets cache rules (copied to dist/ by Vite).
# Hashed file names never change content, so they cache for a year.
/build/*
  Cache-Control: public, max-age=31536000, immutable

# The page itself always revalidates, so the TV's 2-hour reload picks up a deploy.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
