{
  "id": "L1",
  "title": "Landing page, live (with the Fresh from the booth banner)",
  "frame": "app",
  "enter": "swipe",
  "lower": "{name}'s page is live",
  "strip": {
    "label": "CMS · works with",
    "names": [
      "Contentful",
      "WordPress",
      "SFCC Page Designer"
    ]
  },
  "steps": [
    {
      "at": 1.3,
      "do": "hide",
      "target": "#banner",
      "anim": "lift"
    },
    {
      "at": 1.5,
      "do": "show",
      "target": "#hero",
      "anim": "pop"
    },
    {
      "at": 2.3,
      "do": "cursor",
      "target": "#cta",
      "dur": 0.8
    },
    {
      "at": 3.4,
      "do": "click",
      "target": "#cta"
    }
  ]
}
