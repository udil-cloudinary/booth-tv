{
  "id": "B5",
  "title": "Landing page in our CMS, extension beside it",
  "frame": "app",
  "lower": "Write the page. Cloudinary brings the media",
  "strip": {
    "label": "CMS · works with",
    "names": [
      "Contentful",
      "WordPress",
      "SFCC Page Designer"
    ]
  },
  "steps": [
    {
      "at": 0.1,
      "do": "type",
      "target": "#title",
      "text": "{headline}",
      "cps": 32
    },
    {
      "at": 1.2,
      "do": "show",
      "target": "#scan",
      "anim": "fade"
    },
    {
      "at": 1.8,
      "do": "set",
      "target": "#scan",
      "add": "is-done"
    },
    {
      "at": 1.8,
      "do": "set",
      "target": "#scan-t",
      "text": "2 matches, ranked"
    },
    {
      "at": 1.9,
      "do": "show",
      "target": "#r1",
      "anim": "grow"
    },
    {
      "at": 2.1,
      "do": "show",
      "target": "#r2",
      "anim": "grow"
    },
    {
      "at": 2.2,
      "do": "cursor",
      "target": "#insert",
      "dur": 0.5
    },
    {
      "at": 2.8,
      "do": "click",
      "target": "#insert",
      "zoom": false
    },
    {
      "at": 2.9,
      "do": "hide",
      "target": "#empty"
    },
    {
      "at": 2.9,
      "do": "fly",
      "target": "#r1img",
      "to": "#hero",
      "dur": 0.8,
      "withCursor": true
    },
    {
      "at": 3.8,
      "do": "show",
      "target": "#tchip",
      "anim": "pop",
      "zoom": 1.04
    },
    {
      "at": 4,
      "do": "set",
      "target": "#hero",
      "add": "is-cropped"
    }
  ]
}
