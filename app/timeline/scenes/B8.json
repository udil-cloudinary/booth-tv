{
  "id": "B8",
  "title": "Product page in our store admin",
  "frame": "app",
  "lower": "Same trick in the store",
  "strip": {
    "label": "Ecomm · works with",
    "names": [
      "Shopify",
      "SFCC",
      "Adobe Commerce"
    ]
  },
  "steps": [
    {
      "at": 0.2,
      "do": "type",
      "target": "#title",
      "text": "{productName}",
      "cps": 20
    },
    {
      "at": 1.3,
      "do": "type",
      "target": "#price",
      "text": "{price}",
      "cps": 8
    },
    {
      "at": 2.1,
      "do": "show",
      "target": "#sug-h",
      "anim": "fade"
    },
    {
      "at": 2.3,
      "do": "show",
      "target": "#sug",
      "anim": "rise"
    },
    {
      "at": 3,
      "do": "cursor",
      "target": "#insert",
      "dur": 0.6
    },
    {
      "at": 3.7,
      "do": "click",
      "target": "#insert",
      "zoom": false
    },
    {
      "at": 3.9,
      "do": "fly",
      "target": "#simg",
      "to": "#pimg",
      "dur": 0.9,
      "withCursor": true
    },
    {
      "at": 4.9,
      "do": "show",
      "target": "#note",
      "anim": "rise",
      "zoom": 1.03
    }
  ]
}
