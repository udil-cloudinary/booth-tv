{
  "id": "B9",
  "title": "Publish",
  "frame": "card",
  "lower": "Published everywhere",
  "strip": {
    "label": "Cloudinary inside every tool you already work in"
  },
  "steps": [
    {
      "at": 0.1,
      "do": "cursor",
      "target": "#pub",
      "dur": 0.7
    },
    {
      "at": 0.9,
      "do": "click",
      "target": "#pub"
    },
    {
      "at": 1,
      "do": "set",
      "target": "#pub",
      "add": "is-busy"
    },
    {
      "at": 2,
      "do": "set",
      "target": "#pub",
      "remove": "is-busy",
      "add": "is-done"
    },
    {
      "at": 2.1,
      "do": "show",
      "target": "#toast",
      "anim": "drop"
    },
    {
      "at": 2.3,
      "do": "set",
      "target": "#pg1",
      "add": "is-live"
    },
    {
      "at": 2.6,
      "do": "set",
      "target": "#pg2",
      "add": "is-live"
    }
  ]
}
