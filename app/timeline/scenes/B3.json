      "target": "#ly-art",
      "group": ".layer"
    },
    {
      "at": 1.2,
      "do": "show",
      "target": "#tag",
      "anim": "pop"
    },
    {
      "at": 1.4,
      "do": "hide",
      "target": "#f-gel"
