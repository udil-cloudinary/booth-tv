{
  "id": "B6",
  "title": "Product page in our store admin",
  "frame": "app",
  "lower": "Same trick in the store",
  "strip": {
    "label": "Ecomm · works with",
    "names": [
      "Shopify",
      "SFCC",
      "Adobe Commerce"
    ]
  },
  "steps": [
    {
      "at": 0.5,
      "do": "type",
      "target": "#title",
      "text": "{productName}",
      "cps": 28,
      "zoom": false
    },
    {
      "at": 1.15,
      "do": "type",
      "target": "#price",
      "text": "{price}",
      "cps": 12,
      "zoom": false
    },
    {
      "at": 1.6,
      "do": "set",
      "target": "#ftext",
      "text": "{productName}",
      "zoom": false
    },
    {
      "at": 1.7,
      "do": "set",
      "target": "#counts",
      "text": "3 found",
      "add": "is-done",
      "zoom": false
    },
    {
      "at": 1.7,
      "do": "show",
      "target": "#row",
      "anim": "grow",
      "dur": 0.3,
      "zoom": false
    },
    {
      "at": 1.8,
      "do": "show",
      "target": "#c1",
      "anim": "pop",
      "zoom": false
    },
    {
      "at": 1.9,
      "do": "show",
      "target": "#c2",
      "anim": "pop",
      "zoom": false
    },
    {
      "at": 2.0,
      "do": "show",
      "target": "#c3",
      "anim": "pop",
      "zoom": false
    },
    {
      "at": 2.3,
      "do": "cursor",
      "target": "#c1img",
      "dur": 0.6,
      "zoom": false
    },
    {
      "at": 2.9,
      "do": "set",
      "target": "#c1",
      "add": "is-hover",
      "zoom": false
    },
    {
      "at": 3.1,
      "do": "click",
      "target": "#place",
      "zoom": false
    },
    {
      "at": 3.25,
      "do": "fly",
      "target": "#c1img",
      "to": "#pimg",
      "dur": 0.8
    },
    {
      "at": 3.8,
      "do": "show",
      "target": "#tthumb",
      "anim": "pop",
      "zoom": false
    },
    {
      "at": 3.8,
      "do": "set",
      "target": "#tstate",
      "text": "{productSlug} · from Cloudinary",
      "add": "is-cld",
      "zoom": false
    },
    {
      "at": 4.0,
      "do": "show",
      "target": "#note",
      "anim": "rise",
      "zoom": false
    }
  ]
}
