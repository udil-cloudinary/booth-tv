{
  "id": "B6",
  "title": "Product page in our store admin",
  "frame": "app",
  "lower": "Same trick in the store",
  "strip": {
    "label": "Ecomm · works with",
    "names": [
      "Shopify",
      "SFCC",
      "Adobe Commerce"
    ]
  },
  "steps": [
    {
      "at": 0.1,
      "do": "type",
      "target": "#title",
      "text": "{productName}",
      "cps": 26
    },
    {
      "at": 0.8,
      "do": "type",
      "target": "#price",
      "text": "{price}",
      "cps": 12
    },
    {
      "at": 1.2,
      "do": "show",
      "target": "#sug-h",
      "anim": "fade"
    },
    {
      "at": 1.3,
      "do": "show",
      "target": "#sug",
      "anim": "rise"
    },
    {
      "at": 1.9,
      "do": "fly",
      "target": "#simg",
      "to": "#pimg",
      "dur": 0.8
    },
    {
      "at": 2.8,
      "do": "show",
      "target": "#note",
      "anim": "rise",
      "zoom": 1.03
    }
  ]
}
