{
  "name": "booth-tv",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "node scripts/check-timeline.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host --port 4173",
    "check": "node scripts/check-timeline.mjs",
    "deploy": "node scripts/check-deploy-env.mjs && npm run build && wrangler deploy",
    "deploy:preview": "node scripts/check-deploy-env.mjs && npm run build && wrangler versions upload"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0"
  },
  "allowScripts": {
    "workerd@1.20261001.1": true
  }
}
