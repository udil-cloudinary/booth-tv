# Copy to .env (never commit .env). All values are public: the TV holds no secret.

# Where the visitor data comes from: "mock" (assets/mock) or "search" (VITE_SEARCH_URL).
# Override at runtime with ?mock=1 or ?mock=0.
VITE_PROVIDER=mock

# Signed Cloudinary search URL for the booth cloud, from `node scripts/sign-search-url.mjs` (run once with the
# API secret; the URL itself holds no secret). Anyone with it can read the visitors, emails included: keep it out of git.
VITE_SEARCH_URL=

# Optional: one log endpoint (POST, JSON lines) for "visitors shown / cycles / skips / errors". Empty = console only.
VITE_LOG_URL=
