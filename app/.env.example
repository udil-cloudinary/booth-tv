# Copy to .env (never commit .env). All values are public: the TV holds no secret.

# Where the visitor data comes from: "mock" (assets/mock, no backend) or "http" (the booth backend).
# Override at runtime with ?mock=1 or ?mock=0.
VITE_PROVIDER=mock

# Base URL of the booth backend (serves GET /api/tv/visitors). Empty = same origin as the TV page.
VITE_API_BASE=

# Only if the backend sets TV_READ_TOKEN: the same value. Not a Cloudinary secret, but keep it out of git.
VITE_API_TOKEN=

# Optional: one log endpoint (POST, JSON lines) for "visitors shown / cycles / skips / errors". Empty = console only.
VITE_LOG_URL=
